    {
      "parameters": {
        "jsCode": "return \(input.all().map(entry => {\n  const item = entry.json.body || entry.json;\n\n  const headline = item.title ? `\){item.title}\\n\\n` : '';\n  const body = item.description || '';\n  const tags = item.tags_string || (item.tags || []).map(t => \n    `#\({t.replace(/^#/, '')}`).join(' ');\n\n  let rawUrl = item.mediaUrl || (item.mediaUrls && item.mediaUrls[0]) || '';\n  const publicUrl = rawUrl.replace(/^http:\\/\\/[^/]+/, 'https://your-domain.com');\n\n  const fileName = publicUrl.split('/').pop();\n\n  return {\n    json: {\n      id: item.id,\n      platforms: item.platforms || [],\n      fullCaption: `\){headline}\({body}\\n\\n\){tags}`.trim(),\n      mediaUrl: publicUrl,\n      editedMediaUrl: `https://your-domain.com/uploads/edited_${fileName}`,\n      fileName: fileName,\n      mediaUrls: (item.mediaUrls || []).map(u => \n        u.replace(/^http:\\/\\/[^/]+/, 'https://your-domain.com')),\n      postType: item.postType || 'text'\n    }\n  };\n});"
      },
